{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ai-interview-api.onrender.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://ai-interview.vercel.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ai-interview-api.onrender.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://ai-interview.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
