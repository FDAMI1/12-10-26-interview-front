# Where the app finds the API in development. Must match PORT in interview-back/.env.
EXPO_PUBLIC_API_URL_DEV=http://localhost:6010/api/v1
# The API address baked into production builds. Set it in Vercel for the website;
# the phone app takes it from eas.json.
EXPO_PUBLIC_API_URL=
# The website address, used by the phone app to open the privacy pages.
EXPO_PUBLIC_WEB_URL=
# Expo access token for EAS builds. Never commit a real one.
EXPO_TOKEN=
